#!/usr/bin/env bash
# CLK launcher.
#
# Resolves two anchors:
#   * HARNESS_HOME  - directory holding clk_harness/, scripts/, pyproject.toml
#                     (this script's parent's parent). Both layouts work:
#                       source tree      -> HARNESS_HOME == repo root
#                       kickoff layout   -> HARNESS_HOME == <kickoff>/.clk/harness
#   * PROJECT_ROOT  - directory containing .clk/ (where harness state lives).
#                     Defaults to HARNESS_HOME for the source-tree case, but
#                     the kickoff shim exports CLK_PROJECT_ROOT explicitly.
#
# Python interpreter selection order:
#   1. Caller's active virtualenv ($VIRTUAL_ENV/bin/python) — respects
#      whatever venv the user already activated.
#   2. Project-local .clk/venv — created by install_local.sh.
#   3. python3 / python on PATH (system or conda, etc.).

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
HARNESS_HOME="$(cd -- "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"
PROJECT_ROOT="${CLK_PROJECT_ROOT:-$HARNESS_HOME}"

PY=""
if [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
  PY="$VIRTUAL_ENV/bin/python"
elif [ -x "$PROJECT_ROOT/.clk/venv/bin/python" ]; then
  # Only use the project venv if it actually has the required runtime deps.
  # A stale venv missing uvicorn or fastapi should fall through to the system
  # python so a plain `pip install -r requirements.txt` just works.
  if "$PROJECT_ROOT/.clk/venv/bin/python" -c "import uvicorn, fastapi" 2>/dev/null; then
    PY="$PROJECT_ROOT/.clk/venv/bin/python"
  fi
fi
if [ -z "$PY" ]; then
  if command -v python3 >/dev/null 2>&1; then
    PY="$(command -v python3)"
  elif command -v python >/dev/null 2>&1; then
    PY="$(command -v python)"
  else
    echo "clk: no python interpreter found on PATH" >&2
    exit 127
  fi
fi

EXTRA_PATH="$HARNESS_HOME"
if [ -d "$PROJECT_ROOT/.clk/site-packages" ]; then
  EXTRA_PATH="$PROJECT_ROOT/.clk/site-packages:$EXTRA_PATH"
fi
export PYTHONPATH="${EXTRA_PATH}${PYTHONPATH:+:${PYTHONPATH}}"
# cd into PROJECT_ROOT so relative paths printed by the harness and any
# subprocess defaults align with the user's expected working directory.
cd "$PROJECT_ROOT"
exec "$PY" -m clk_harness.cli "$@"
